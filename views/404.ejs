<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>404 — helloworld</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >
</head>

<body class="error-page">

    <main class="error-screen">

        <div class="error-mark">
            404
        </div>

        <div class="error-line"></div>

        <p class="error-label">
            page not found
        </p>

        <h1>
            this page doesn't exist.
        </h1>

        <p class="error-description">
            either the page was moved, deleted, or you somehow ended up
            somewhere you weren't supposed to be.
        </p>

        <div class="error-actions">

            <a
                href="/feed"
                class="error-button error-button-primary"
            >
                go home
            </a>

            <a
                href="/search"
                class="error-button error-button-secondary"
            >
                search
            </a>

        </div>

        <div class="error-footer">
            helloworld
        </div>

    </main>

</body>
</html>
