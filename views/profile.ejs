<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        @<%= profile.username %> - helloworld
    </title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

</head>


<body>

    <%- include("partials/sidebar", { user: user }) %>


    <main class="container page profile-page">

        <section class="profile-header">

            <div class="profile-top">

                <% if (profile.profile_picture) { %>

                    <img
                        src="<%= profile.profile_picture %>"
                        alt="profile picture"
                        class="profile-picture"
                    >

                <% } else { %>

                    <div class="profile-picture-placeholder">

                        <%= profile.username
                            ? profile.username.charAt(0).toUpperCase()
                            : "?" %>

                    </div>

                <% } %>


                <div class="profile-info">

                    <h1>
                        <%= profile.display_name || profile.username %>
                    </h1>

                    <div class="profile-username">
                        @<%= profile.username %>
                    </div>


                    <% if (profile.bio) { %>

                        <div class="profile-bio">
                            <%= profile.bio %>
                        </div>

                    <% } %>

                </div>

            </div>


            <div class="profile-stats">

                <div class="profile-stat">

                    <strong>
                        <%= posts ? posts.length : 0 %>
                    </strong>

                    <span>
                        posts
                    </span>

                </div>

            </div>


            <% if (
                user &&
                profile &&
                user.id &&
                profile.id &&
                String(user.id) === String(profile.id)
            ) { %>

                <div class="profile-actions">

                    <a
                        href="/settings/profile"
                        class="button button-secondary"
                    >
                        edit profile
                    </a>

                </div>

            <% } %>

        </section>


        <section class="profile-posts">

            <div class="section-heading">

                <h2>
                    posts
                </h2>

            </div>


            <% if (posts && posts.length) { %>

                <% posts.forEach(post => { %>

                    <article class="post">

                        <div class="post-header">

                            <div class="post-user">

                                <a
                                    href="/u/<%= encodeURIComponent(profile.username) %>"
                                >
                                    @<%= profile.username %>
                                </a>

                            </div>


                            <% if (post.created_at) { %>

                                <span class="post-date">
                                    <%= new Date(post.created_at).toLocaleString() %>
                                </span>

                            <% } %>

                        </div>


                        <% if (post.community_name) { %>

                            <div class="post-community">

                                <a
                                    href="/c/<%= encodeURIComponent(post.community_name) %>"
                                >
                                    c/<%= post.community_name %>
                                </a>

                            </div>

                        <% } %>


                        <a
                            href="/post/<%= post.id %>"
                            class="post-main-link"
                        >

                            <div class="post-content">
                                <%= post.content %>
                            </div>

                        </a>


                        <% if (post.image_url || post.image) { %>

                            <div class="post-attachment">

                                <img
                                    src="<%= post.image_url || post.image %>"
                                    alt="post attachment"
                                >

                            </div>

                        <% } %>

                    </article>

                <% }) %>

            <% } else { %>

                <div class="empty">

                    <strong>
                        no posts yet
                    </strong>

                    <p>
                        this user hasn't posted anything yet.
                    </p>

                </div>

            <% } %>

        </section>

    </main>

</body>

</html>
