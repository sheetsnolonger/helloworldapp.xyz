<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta
        name="viewport"
        content="width=device-width,initial-scale=1"
    >

    <title>admin — helloworld</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

<main class="auth-box admin-auth">

    <h1>helloworld</h1>
    <h2>admin</h2>

    <% if (error) { %>

        <div class="error">
            <%= error %>
        </div>

    <% } %>

    <form method="post">

        <input
            type="password"
            name="password"
            placeholder="password"
            required
        >

        <button type="submit">
            enter
        </button>

    </form>

</main>

</body>
</html>
