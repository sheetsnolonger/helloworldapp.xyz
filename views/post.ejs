<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        post — helloworld
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

<nav>

    <a
        class="logo"
        href="/feed"
    >
        helloworld
    </a>

    <div class="nav-right">

        <a href="/feed">
            feed
        </a>

        <a href="/u/<%= user.username %>">
            @<%= user.username %>
        </a>

        <form
            action="/logout"
            method="post"
        >

            <button
                class="logout"
                type="submit"
            >
                logout
            </button>

        </form>

    </div>

</nav>


<main class="container post-page">

    <a
        class="back-link"
        href="/feed"
    >
        ← back to feed
    </a>


    <article class="post">

        <div class="post-header">

            <a
                href="/u/<%= post.username %>"
            >
                @<%= post.username %>
            </a>

            <span>
                <%= formatDate(post.created_at) %>
            </span>

        </div>


        <% if (post.community_name) { %>

            <div class="post-community">

                <a
                    href="/c/<%= post.community_name %>"
                >
                    c/<%= post.community_name %>
                </a>

            </div>

        <% } %>


        <div class="post-content">
            <%= post.content %>
        </div>


        <div class="post-actions">

            <form
                action="/posts/<%= post.id %>/like"
                method="post"
            >

                <button
                    type="submit"
                    class="<%= post.liked ? 'liked' : '' %>"
                >

                    <%= post.liked
                        ? "liked"
                        : "like"
                    %>

                    <%= post.likes || 0 %>

                </button>

            </form>


            <% if (
                Number(user.id) ===
                Number(post.user_id)
            ) { %>

                <form
                    action="/posts/<%= post.id %>/delete"
                    method="post"
                    onsubmit="return confirm('delete this post?');"
                >

                    <button
                        type="submit"
                        class="delete-post"
                    >
                        delete
                    </button>

                </form>

            <% } %>

        </div>

    </article>


    <section class="comments-page">

        <div class="tiny">
            comments
        </div>

        <h2>
            <%= comments.length %>
            <%= comments.length === 1
                ? "comment"
                : "comments"
            %>
        </h2>


        <form
            class="comment-form"
            action="/posts/<%= post.id %>/comments"
            method="post"
        >

            <input
                type="text"
                name="content"
                maxlength="300"
                placeholder="write a comment..."
                autocomplete="off"
                required
            >

            <button type="submit">
                comment
            </button>

        </form>


        <div class="comment-list">

            <% if (comments.length === 0) { %>

                <div class="empty">
                    no comments yet.
                </div>

            <% } %>


            <% comments.forEach(comment => { %>

                <article class="comment">

                    <div class="comment-header">

                        <a
                            href="/u/<%= comment.username %>"
                        >
                            @<%= comment.username %>
                        </a>

                        <span>
                            <%= formatDate(
                                comment.created_at
                            ) %>
                        </span>

                    </div>


                    <div class="comment-content">
                        <%= comment.content %>
                    </div>

                </article>

            <% }) %>

        </div>

    </section>

</main>

</body>

</html>
