<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>search - helloworld</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <%- include("sidebar", { user: user }) %>

    <main class="site-main">

        <div class="page-container">

            <div class="page-header">
                <h1>search</h1>
            </div>

            <form
                action="/search"
                method="get"
                class="search-form"
            >

                <input
                    type="text"
                    name="q"
                    value="<%= query || '' %>"
                    placeholder="search..."
                    maxlength="100"
                >

                <button type="submit">
                    search
                </button>

            </form>

            <% if (query) { %>

                <p>
                    results for:
                    <strong><%= query %></strong>
                </p>


                <section class="search-section">

                    <h2>users</h2>

                    <% if (users.length === 0) { %>

                        <p>no users found.</p>

                    <% } else { %>

                        <% users.forEach(function(foundUser) { %>

                            <a
                                href="/u/<%= foundUser.username %>"
                                class="search-result"
                            >

                                <% if (foundUser.profile_picture) { %>

                                    <img
                                        src="<%= foundUser.profile_picture %>"
                                        alt=""
                                        class="search-avatar"
                                    >

                                <% } else { %>

                                    <div class="search-avatar search-avatar-empty">
                                        <%= foundUser.username.charAt(0).toUpperCase() %>
                                    </div>

                                <% } %>

                                <div>

                                    <strong>
                                        <%= foundUser.display_name || foundUser.username %>
                                    </strong>

                                    <br>

                                    <span>
                                        @<%= foundUser.username %>
                                    </span>

                                </div>

                            </a>

                        <% }) %>

                    <% } %>

                </section>


                <section class="search-section">

                    <h2>communities</h2>

                    <% if (communities.length === 0) { %>

                        <p>no communities found.</p>

                    <% } else { %>

                        <% communities.forEach(function(community) { %>

                            <a
                                href="/c/<%= community.name %>"
                                class="search-result"
                            >

                                <div class="search-community-icon">
                                    #
                                </div>

                                <div>

                                    <strong>
                                        c/<%= community.name %>
                                    </strong>

                                    <% if (community.description) { %>

                                        <br>

                                        <span>
                                            <%= community.description %>
                                        </span>

                                    <% } %>

                                    <br>

                                    <small>
                                        <%= community.post_count %> posts
                                    </small>

                                </div>

                            </a>

                        <% }) %>

                    <% } %>

                </section>


                <section class="search-section">

                    <h2>posts</h2>

                    <% if (posts.length === 0) { %>

                        <p>no posts found.</p>

                    <% } else { %>

                        <% posts.forEach(function(post) { %>

                            <div class="search-post">

                                <div class="search-post-meta">

                                    <a href="/u/<%= post.username %>">
                                        @<%= post.username %>
                                    </a>

                                    <% if (post.community_name) { %>

                                        <span>
                                            in
                                            <a href="/c/<%= post.community_name %>">
                                                c/<%= post.community_name %>
                                            </a>
                                        </span>

                                    <% } %>

                                </div>

                                <div class="search-post-content">
                                    <%= post.content %>
                                </div>

                            </div>

                        <% }) %>

                    <% } %>

                </section>

            <% } else { %>

                <p>
                    enter something to search for users,
                    communities, or posts.
                </p>

            <% } %>

        </div>

    </main>

</body>
</html>
