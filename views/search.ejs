<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>search - helloworld</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >
</head>

<body>

    <%- include("partials/sidebar") %>

    <main class="container page">

        <header class="page-header">

            <div class="tiny">
                find people and posts
            </div>

            <h1>
                search
            </h1>

            <p>
                search helloworld for users, communities, and posts.
            </p>

        </header>


        <section class="search-box">

            <form
                class="search-form"
                action="/search"
                method="get"
            >

                <input
                    type="search"
                    name="q"
                    value="<%= typeof q !== 'undefined' ? q : '' %>"
                    placeholder="search..."
                    autocomplete="off"
                >

                <button type="submit">
                    search
                </button>

            </form>

        </section>


        <% if (typeof q !== 'undefined' && q) { %>

            <div class="search-query">
                results for
                <strong>
                    "<%= q %>"
                </strong>
            </div>


            <% if (users && users.length) { %>

                <section class="search-results">

                    <div class="section-heading">
                        <h2>people</h2>
                    </div>

                    <% users.forEach(result => { %>

                        <a
                            class="search-user"
                            href="/u/<%= encodeURIComponent(result.username) %>"
                        >

                            <% if (result.profile_picture) { %>

                                <img
                                    src="<%= result.profile_picture %>"
                                    alt=""
                                    class="search-avatar"
                                >

                            <% } else { %>

                                <div class="search-avatar search-avatar-placeholder">
                                    <%= result.username.charAt(0).toUpperCase() %>
                                </div>

                            <% } %>

                            <div class="search-user-info">

                                <strong>
                                    @<%= result.username %>
                                </strong>

                                <% if (result.display_name) { %>

                                    <span>
                                        <%= result.display_name %>
                                    </span>

                                <% } %>

                            </div>

                        </a>

                    <% }) %>

                </section>

            <% } %>


            <% if (communities && communities.length) { %>

                <section class="search-results">

                    <div class="section-heading">
                        <h2>communities</h2>
                    </div>

                    <% communities.forEach(community => { %>

                        <a
                            class="search-community"
                            href="/c/<%= encodeURIComponent(community.name) %>"
                        >

                            <div class="search-community-icon">
                                c/
                            </div>

                            <div>

                                <strong>
                                    c/<%= community.name %>
                                </strong>

                                <% if (community.description) { %>

                                    <p>
                                        <%= community.description %>
                                    </p>

                                <% } %>

                            </div>

                        </a>

                    <% }) %>

                </section>

            <% } %>


            <% if (posts && posts.length) { %>

                <section class="search-results">

                    <div class="section-heading">
                        <h2>posts</h2>
                    </div>

                    <% posts.forEach(post => { %>

                        <a
                            class="search-post"
                            href="/posts/<%= post.id %>/comments"
                        >

                            <div class="search-post-header">

                                <strong>
                                    @<%= post.username %>
                                </strong>

                                <span>
                                    <%= formatDate(post.created_at) %>
                                </span>

                            </div>

                            <% if (post.community_name) { %>

                                <div class="search-post-community">
                                    c/<%= post.community_name %>
                                </div>

                            <% } %>

                            <div class="search-post-content">
                                <%= post.content %>
                            </div>

                        </a>

                    <% }) %>

                </section>

            <% } %>


            <% if (
                (!users || !users.length) &&
                (!communities || !communities.length) &&
                (!posts || !posts.length)
            ) { %>

                <div class="empty">

                    <strong>
                        nothing found.
                    </strong>

                    <p>
                        try searching for something else.
                    </p>

                </div>

            <% } %>

        <% } else { %>

            <div class="empty">

                <strong>
                    search helloworld.
                </strong>

                <p>
                    enter something above to get started.
                </p>

            </div>

        <% } %>

    </main>

</body>
</html>
