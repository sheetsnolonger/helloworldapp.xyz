<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta
        name="viewport"
        content="width=device-width,initial-scale=1"
    >

    <title>search — helloworld</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

<nav class="topbar">

    <a class="brand" href="/feed">
        helloworld
    </a>

    <form
        class="search"
        action="/search"
        method="get"
    >
        <input
            name="q"
            value="<%= query %>"
            placeholder="search"
            autofocus
        >
    </form>

</nav>

<main class="page">

    <h1>
        search
        <% if (query) { %>
            for "<%= query %>"
        <% } %>
    </h1>

    <% if (!query) { %>

        <div class="empty">
            search for users, posts, or communities.
        </div>

    <% } %>

    <% if (users.length) { %>

        <section class="search-section">

            <h2>users</h2>

            <% users.forEach(foundUser => { %>

                <a
                    class="search-user"
                    href="/u/<%= foundUser.username %>"
                >

                    <% if (foundUser.profile_picture) { %>

                        <img
                            class="avatar"
                            src="<%= foundUser.profile_picture %>"
                            alt=""
                        >

                    <% } else { %>

                        <div class="avatar placeholder">
                            <%= foundUser.username[0].toUpperCase() %>
                        </div>

                    <% } %>

                    <div>
                        <strong>
                            <%= foundUser.display_name || foundUser.username %>
                        </strong>

                        <span>
                            @<%= foundUser.username %>
                        </span>
                    </div>

                </a>

            <% }) %>

        </section>

    <% } %>

    <% if (communities.length) { %>

        <section class="search-section">

            <h2>communities</h2>

            <% communities.forEach(community => { %>

                <a
                    class="search-community"
                    href="/c/<%= community.name %>"
                >
                    <strong>
                        #<%= community.name %>
                    </strong>

                    <span>
                        <%= community.description %>
                    </span>
                </a>

            <% }) %>

        </section>

    <% } %>

    <% if (posts.length) { %>

        <section class="search-section">

            <h2>posts</h2>

            <% posts.forEach(post => { %>

                <a
                    class="search-post"
                    href="/posts/<%= post.id %>/comments"
                >

                    <strong>
                        @<%= post.username %>
                    </strong>

                    <p>
                        <%= post.content %>
                    </p>

                    <small>
                        <%= post.likes %> likes
                        ·
                        <%= post.comments %> comments
                    </small>

                </a>

            <% }) %>

        </section>

    <% } %>

</main>

</body>
</html>
</body>
</html>
