<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>search - helloworld</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >
</head>

<body>

    <%- include("partials/sidebar", { user: user }) %>

    <main class="site-main">

        <div class="page-container">

            <div class="page-header">
                <h1>search</h1>
            </div>

            <form
                action="/search"
                method="get"
                class="search-form"
            >

                <input
                    type="text"
                    name="q"
                    value="<%= query || '' %>"
                    placeholder="search..."
                    maxlength="100"
                    autocomplete="off"
                >

                <button type="submit">
                    search
                </button>

            </form>

            <% if (query) { %>

                <div class="search-query">
                    results for:
                    <strong><%= query %></strong>
                </div>

                <section class="search-section">

                    <h2>users</h2>

                    <% if (!users || users.length === 0) { %>

                        <p class="muted">
                            no users found.
                        </p>

                    <% } else { %>

                        <div class="search-results">

                            <% users.forEach(function(foundUser) { %>

                                <a
                                    href="/u/<%= foundUser.username %>"
                                    class="search-result"
                                >

                                    <div class="search-result-avatar">

                                        <% if (
                                            foundUser.profile_picture ||
                                            foundUser.profile_image_url
                                        ) { %>

                                            <img
                                                src="<%= foundUser.profile_picture || foundUser.profile_image_url %>"
                                                alt=""
                                                loading="lazy"
                                            >

                                        <% } else { %>

                                            <span>
                                                <%= (
                                                    foundUser.display_name ||
                                                    foundUser.username ||
                                                    "?"
                                                ).charAt(0).toUpperCase() %>
                                            </span>

                                        <% } %>

                                    </div>

                                    <div class="search-result-info">

                                        <strong>
                                            <%= foundUser.display_name || foundUser.username %>
                                        </strong>

                                        <span>
                                            @<%= foundUser.username %>
                                        </span>

                                    </div>

                                </a>

                            <% }) %>

                        </div>

                    <% } %>

                </section>


                <section class="search-section">

                    <h2>communities</h2>

                    <% if (
                        !communities ||
                        communities.length === 0
                    ) { %>

                        <p class="muted">
                            no communities found.
                        </p>

                    <% } else { %>

                        <div class="search-results">

                            <% communities.forEach(function(community) { %>

                                <a
                                    href="/c/<%= community.name %>"
                                    class="search-result"
                                >

                                    <div class="search-result-avatar search-community-avatar">
                                        #
                                    </div>

                                    <div class="search-result-info">

                                        <strong>
                                            c/<%= community.name %>
                                        </strong>

                                        <% if (community.description) { %>

                                            <span>
                                                <%= community.description %>
                                            </span>

                                        <% } %>

                                        <small>
                                            <%= community.post_count || 0 %> posts
                                        </small>

                                    </div>

                                </a>

                            <% }) %>

                        </div>

                    <% } %>

                </section>


                <section class="search-section">

                    <h2>posts</h2>

                    <% if (!posts || posts.length === 0) { %>

                        <p class="muted">
                            no posts found.
                        </p>

                    <% } else { %>

                        <div class="search-posts">

                            <% posts.forEach(function(post) { %>

                                <article class="search-post">

                                    <div class="search-post-header">

                                        <a
                                            href="/u/<%= post.username %>"
                                        >
                                            @<%= post.username %>
                                        </a>

                                        <% if (post.community_name) { %>

                                            <span>
                                                in
                                            </span>

                                            <a
                                                href="/c/<%= post.community_name %>"
                                            >
                                                c/<%= post.community_name %>
                                            </a>

                                        <% } %>

                                    </div>

                                    <div class="search-post-content">
                                        <%= post.content %>
                                    </div>

                                    <% if (post.attachment_url) { %>

                                        <div class="search-post-attachment">

                                            <img
                                                src="<%= post.attachment_url %>"
                                                alt="<%= post.attachment_name || 'post attachment' %>"
                                                loading="lazy"
                                            >

                                        </div>

                                    <% } %>

                                    <div class="search-post-date">

                                        <% if (typeof formatDate === "function") { %>

                                            <%= formatDate(post.created_at) %>

                                        <% } else { %>

                                            <%= new Date(post.created_at).toLocaleString() %>

                                        <% } %>

                                    </div>

                                </article>

                            <% }) %>

                        </div>

                    <% } %>

                </section>

            <% } else { %>

                <div class="search-empty">

                    <h2>search helloworld</h2>

                    <p>
                        search for users, communities, or posts.
                    </p>

                </div>

            <% } %>

        </div>

    </main>

</body>
</html>
