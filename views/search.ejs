<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>communities - helloworld</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >
</head>

<body>

    <%- include("partials/sidebar", { user: user }) %>

    <main class="container page communities-page">

        <header class="page-header">
            <div class="tiny">
                find your people
            </div>

            <h1>
                communities
            </h1>

            <p>
                discover communities and join conversations.
            </p>
        </header>


        <% if (typeof error !== "undefined" && error) { %>

            <div class="error">
                <%= error %>
            </div>

        <% } %>


        <% if (typeof success !== "undefined" && success) { %>

            <div class="success">
                <%= success %>
            </div>

        <% } %>


        <% if (typeof userCommunities !== "undefined" && userCommunities && userCommunities.length) { %>

            <section class="page-section">

                <div class="section-heading">
                    <h2>
                        your communities
                    </h2>
                </div>

                <div class="community-grid">

                    <% userCommunities.forEach(community => { %>

                        <a
                            href="/c/<%= encodeURIComponent(community.name) %>"
                            class="community-card"
                        >

                            <div class="community-card-icon">
                                <svg
                                    viewBox="0 0 24 24"
                                    aria-hidden="true"
                                >
                                    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 4v-4.2A2.5 2.5 0 0 1 4 13.5z"/>
                                </svg>
                            </div>

                            <div class="community-card-content">

                                <strong>
                                    c/<%= community.name %>
                                </strong>

                                <% if (community.description) { %>

                                    <span>
                                        <%= community.description %>
                                    </span>

                                <% } %>

                            </div>

                        </a>

                    <% }) %>

                </div>

            </section>

        <% } %>


        <section class="page-section">

            <div class="section-heading">

                <div>
                    <h2>
                        all communities
                    </h2>

                    <p class="section-description">
                        browse communities on helloworld.
                    </p>
                </div>

            </div>


            <% if (communities && communities.length) { %>

                <div class="community-grid">

                    <% communities.forEach(community => { %>

                        <a
                            href="/c/<%= encodeURIComponent(community.name) %>"
                            class="community-card"
                        >

                            <div class="community-card-icon">

                                <svg
                                    viewBox="0 0 24 24"
                                    aria-hidden="true"
                                >
                                    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 4v-4.2A2.5 2.5 0 0 1 4 13.5z"/>
                                    <path d="M8 8h8M8 11h5"/>
                                </svg>

                            </div>


                            <div class="community-card-content">

                                <strong>
                                    c/<%= community.name %>
                                </strong>

                                <% if (community.description) { %>

                                    <span>
                                        <%= community.description %>
                                    </span>

                                <% } %>

                                <% if (
                                    typeof community.member_count !== "undefined"
                                ) { %>

                                    <small>
                                        <%= community.member_count %> members
                                    </small>

                                <% } %>

                            </div>

                        </a>

                    <% }) %>

                </div>

            <% } else { %>

                <div class="empty">

                    <strong>
                        no communities yet
                    </strong>

                    <p>
                        there aren't any communities to show right now.
                    </p>

                </div>

            <% } %>

        </section>

    </main>

</body>
</html>
