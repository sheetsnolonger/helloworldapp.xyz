<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>search - helloworld</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >
</head>

<body>

    <%- include("sidebar", { user: user }) %>

    <main class="site-main">

        <div class="page-container">

            <div class="page-header">
                <h1>search</h1>
            </div>

            <form
                class="search-form"
                action="/search"
                method="get"
                autocomplete="off"
            >

                <input
                    type="search"
                    name="q"
                    value="<%= query || '' %>"
                    placeholder="search users, communities, and posts..."
                    maxlength="100"
                    required
                >

                <button type="submit">
                    search
                </button>

            </form>


            <% if (query) { %>

                <div class="search-heading">
                    results for "<%= query %>"
                </div>


                <!-- users -->

                <section class="search-section">

                    <h2>users</h2>

                    <% if (users && users.length) { %>

                        <div class="search-results">

                            <% users.forEach(function(foundUser) { %>

                                <a
                                    class="search-result"
                                    href="/u/<%= encodeURIComponent(foundUser.username) %>"
                                >

                                    <div class="search-result-avatar">

                                        <% if (
                                            foundUser.profile_picture ||
                                            foundUser.profile_image_url
                                        ) { %>

                                            <img
                                                src="<%= foundUser.profile_picture || foundUser.profile_image_url %>"
                                                alt=""
                                            >

                                        <% } else { %>

                                            <div class="search-default-avatar">
                                                <%= foundUser.username.charAt(0).toUpperCase() %>
                                            </div>

                                        <% } %>

                                    </div>

                                    <div class="search-result-info">

                                        <strong>
                                            <%= foundUser.display_name || foundUser.username %>
                                        </strong>

                                        <span>
                                            @<%= foundUser.username %>
                                        </span>

                                    </div>

                                </a>

                            <% }) %>

                        </div>

                    <% } else { %>

                        <p class="search-empty">
                            no users found.
                        </p>

                    <% } %>

                </section>


                <!-- communities -->

                <section class="search-section">

                    <h2>communities</h2>

                    <% if (communities && communities.length) { %>

                        <div class="search-results">

                            <% communities.forEach(function(community) { %>

                                <a
                                    class="search-result"
                                    href="/c/<%= encodeURIComponent(community.name) %>"
                                >

                                    <div class="search-community-icon">
                                        #
                                    </div>

                                    <div class="search-result-info">

                                        <strong>
                                            c/<%= community.name %>
                                        </strong>

                                        <span>
                                            <%= community.description || "no description" %>
                                        </span>

                                        <small>
                                            <%= community.post_count || 0 %> posts
                                        </small>

                                    </div>

                                </a>

                            <% }) %>

                        </div>

                    <% } else { %>

                        <p class="search-empty">
                            no communities found.
                        </p>

                    <% } %>

                </section>


                <!-- posts -->

                <section class="search-section">

                    <h2>posts</h2>

                    <% if (posts && posts.length) { %>

                        <div class="search-results">

                            <% posts.forEach(function(post) { %>

                                <article class="search-post">

                                    <div class="search-post-meta">

                                        <a
                                            href="/u/<%= encodeURIComponent(post.username) %>"
                                        >
                                            @<%= post.username %>
                                        </a>

                                        <% if (post.community_name) { %>

                                            <span>
                                                in
                                            </span>

                                            <a
                                                href="/c/<%= encodeURIComponent(post.community_name) %>"
                                            >
                                                c/<%= post.community_name %>
                                            </a>

                                        <% } %>

                                        <time>
                                            <%= formatDate(post.created_at) %>
                                        </time>

                                    </div>

                                    <div class="search-post-content">
                                        <%= post.content %>
                                    </div>

                                </article>

                            <% }) %>

                        </div>

                    <% } else { %>

                        <p class="search-empty">
                            no posts found.
                        </p>

                    <% } %>

                </section>


            <% } else { %>

                <div class="search-empty search-start">
                    type something above to search.
                </div>

            <% } %>

        </div>

    </main>

</body>
</html>
