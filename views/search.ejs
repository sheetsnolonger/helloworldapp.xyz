<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>search - helloworld</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

</head>


<body>

    <%- include("partials/sidebar", { user: user }) %>


    <main class="container page search-page">

        <header class="page-header">

            <div class="tiny">
                find people and posts
            </div>

            <h1>
                search
            </h1>

            <p>
                search helloworld for users, communities, and posts.
            </p>

        </header>


        <section class="search-box">

            <form
                class="search-form"
                action="/search"
                method="get"
            >

                <div class="search-input-wrap">

                    <svg
                        class="search-input-icon"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <circle
                            cx="11"
                            cy="11"
                            r="6.5"
                        />

                        <path
                            d="m16 16 5 5"
                        />
                    </svg>


                    <input
                        type="search"
                        name="q"
                        value="<%= typeof q !== 'undefined' ? q : '' %>"
                        placeholder="search..."
                        autocomplete="off"
                        aria-label="search"
                    >

                </div>


                <button type="submit">
                    search
                </button>

            </form>

        </section>


        <% if (typeof q !== 'undefined' && q) { %>

            <div class="search-query">

                results for

                <strong>
                    "<%= q %>"
                </strong>

            </div>


            <% if (users && users.length) { %>

                <section class="search-results">

                    <div class="section-heading">
                        <h2>
                            people
                        </h2>
                    </div>


                    <div class="search-user-list">

                        <% users.forEach(result => { %>

                            <a
                                class="search-user"
                                href="/u/<%= encodeURIComponent(result.username) %>"
                            >

                                <% if (result.profile_picture) { %>

                                    <img
                                        src="<%= result.profile_picture %>"
                                        alt=""
                                        class="search-avatar"
                                    >

                                <% } else { %>

                                    <div class="search-avatar search-avatar-placeholder">

                                        <%= result.username
                                            ? result.username.charAt(0).toUpperCase()
                                            : "?" %>

                                    </div>

                                <% } %>


                                <div class="search-user-info">

                                    <strong>
                                        @<%= result.username %>
                                    </strong>

                                    <% if (result.display_name) { %>

                                        <span>
                                            <%= result.display_name %>
                                        </span>

                                    <% } %>

                                    <% if (result.bio) { %>

                                        <small>
                                            <%= result.bio %>
                                        </small>

                                    <% } %>

                                </div>


                                <span class="search-arrow">
                                    →
                                </span>

                            </a>

                        <% }) %>

                    </div>

                </section>

            <% } %>


            <% if (communities && communities.length) { %>

                <section class="search-results">

                    <div class="section-heading">
                        <h2>
                            communities
                        </h2>
                    </div>


                    <div class="search-community-list">

                        <% communities.forEach(result => { %>

                            <a
                                class="search-community"
                                href="/c/<%= encodeURIComponent(result.name) %>"
                            >

                                <span class="search-community-icon">

                                    <svg
                                        viewBox="0 0 24 24"
                                        aria-hidden="true"
                                    >
                                        <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 4v-4.2A2.5 2.5 0 0 1 4 13.5z"/>
                                    </svg>

                                </span>


                                <span class="search-community-info">

                                    <strong>
                                        c/<%= result.name %>
                                    </strong>

                                    <% if (result.description) { %>

                                        <small>
                                            <%= result.description %>
                                        </small>

                                    <% } %>

                                </span>


                                <span class="search-arrow">
                                    →
                                </span>

                            </a>

                        <% }) %>

                    </div>

                </section>

            <% } %>


            <% if (posts && posts.length) { %>

                <section class="search-results">

                    <div class="section-heading">
                        <h2>
                            posts
                        </h2>
                    </div>


                    <% posts.forEach(post => { %>

                        <article class="search-post">

                            <div class="search-post-meta">

                                <% if (post.username) { %>

                                    <a
                                        href="/u/<%= encodeURIComponent(post.username) %>"
                                    >
                                        @<%= post.username %>
                                    </a>

                                <% } %>


                                <% if (post.community_name) { %>

                                    <span>
                                        in
                                    </span>

                                    <a
                                        href="/c/<%= encodeURIComponent(post.community_name) %>"
                                    >
                                        c/<%= post.community_name %>
                                    </a>

                                <% } %>

                            </div>


                            <a
                                href="/post/<%= post.id %>"
                                class="search-post-content"
                            >

                                <%= post.content %>

                            </a>

                        </article>

                    <% }) %>

                </section>

            <% } %>


            <% if (
                (!users || !users.length) &&
                (!communities || !communities.length) &&
                (!posts || !posts.length)
            ) { %>

                <div class="empty search-empty">

                    <strong>
                        no results found
                    </strong>

                    <p>
                        try a different search.
                    </p>

                </div>

            <% } %>


        <% } else { %>

            <div class="empty search-empty">

                <strong>
                    search helloworld
                </strong>

                <p>
                    enter a username, community, or phrase above.
                </p>

            </div>

        <% } %>

    </main>

</body>

</html>
