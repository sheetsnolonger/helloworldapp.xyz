<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= community.name %> — helloworld</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<nav>
    <a class="logo" href="/feed">
        helloworld
    </a>

    <div class="nav-right">
        <a href="/feed">
            feed
        </a>

        <a href="/u/<%= user.username %>">
            @<%= user.username %>
        </a>

        <form action="/logout" method="post">
            <button
                class="logout"
                type="submit"
            >
                logout
            </button>
        </form>
    </div>
</nav>

<main class="container">

    <header class="community-header">

        <div class="tiny">
            community
        </div>

        <h1>
            c/<%= community.name %>
        </h1>

        <% if (community.description) { %>
            <p>
                <%= community.description %>
            </p>
        <% } %>

        <a
            class="button secondary"
            href="/feed"
        >
            back to feed
        </a>

    </header>

    <section class="composer">

        <form
            action="/posts"
            method="post"
        >

            <input
                type="hidden"
                name="community_id"
                value="<%= community.id %>"
            >

            <textarea
                name="content"
                maxlength="500"
                placeholder="post to c/<%= community.name %>..."
                required
            ></textarea>

            <button type="submit">
                post
            </button>

        </form>

    </section>

    <% if (!posts || posts.length === 0) { %>

        <div class="empty">
            <p>
                there aren't any posts here yet.
            </p>

            <p>
                make the first one.
            </p>
        </div>

    <% } %>

    <% posts.forEach(post => { %>

        <article class="post">

            <div class="post-header">

                <a href="/u/<%= post.username %>">
                    @<%= post.username %>
                </a>

                <span>
                    <%= formatDate(post.created_at) %>
                </span>

            </div>

            <div class="post-content">
                <%= post.content %>
            </div>

            <div class="post-actions">

                <form
                    action="/posts/<%= post.id %>/like"
                    method="post"
                >

                    <button
                        type="submit"
                        class="<%= post.liked ? 'liked' : '' %>"
                    >
                        <%= post.liked ? 'liked' : 'like' %>
                        <%= post.likes || 0 %>
                    </button>

                </form>

                <a
                    class="comment-link"
                    href="/posts/<%= post.id %>/comments"
                >
                    <%= post.comments || 0 %>
                    <%= post.comments === 1
                        ? 'comment'
                        : 'comments'
                    %>
                </a>

            </div>

        </article>

    <% }) %>

</main>

</body>
</html>
