<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta
        name="viewport"
        content="width=device-width,initial-scale=1"
    >

    <title>comments — helloworld</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

<nav class="topbar">

    <a class="brand" href="/feed">
        helloworld
    </a>

    <a href="/feed">
        back to feed
    </a>

</nav>

<main class="comments-page">

    <article class="post">

        <div class="post-head">

            <% if (post.profile_picture) { %>

                <img
                    class="avatar"
                    src="<%= post.profile_picture %>"
                    alt=""
                >

            <% } else { %>

                <div class="avatar placeholder">
                    <%= post.username[0].toUpperCase() %>
                </div>

            <% } %>

            <div>
                <a
                    class="username"
                    href="/u/<%= post.username %>"
                >
                    <%= post.display_name || post.username %>
                </a>

                <div class="post-meta">
                    @<%= post.username %>
                    ·
                    <%= formatDate(post.created_at) %>
                </div>
            </div>

        </div>

        <div class="post-body">
            <%= post.content %>
        </div>

    </article>

    <section class="comments-section">

        <h2>comments</h2>

        <% if (!comments.length) { %>

            <div class="empty">
                no comments yet.
            </div>

        <% } %>

        <% comments.forEach(comment => { %>

            <article class="comment">

                <strong>
                    <a href="/u/<%= comment.username %>">
                        @<%= comment.username %>
                    </a>
                </strong>

                <p>
                    <%= comment.content %>
                </p>

                <small>
                    <%= formatDate(comment.created_at) %>
                </small>

            </article>

        <% }) %>

    </section>

    <form
        class="comment-form"
        action="/posts/<%= post.id %>/comments"
        method="post"
    >

        <input
            name="content"
            maxlength="300"
            placeholder="write a comment..."
            required
        >

        <button type="submit">
            comment
        </button>

    </form>

</main>

</body>
</html>
