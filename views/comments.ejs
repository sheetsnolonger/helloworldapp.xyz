<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        comments - helloworld
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body>


<nav>

    <a
        class="logo"
        href="/feed"
    >
        helloworld
    </a>


    <div class="nav-right">

        <a href="/search">
            search
        </a>

        <a href="/communities">
            communities
        </a>

        <a
            href="/u/<%= user.username %>"
        >
            @<%= user.username %>
        </a>


        <form
            action="/logout"
            method="post"
        >

            <button
                class="logout"
                type="submit"
            >
                logout
            </button>

        </form>

    </div>

</nav>


<main class="container">


    <a
        class="back-link"
        href="/feed"
    >
        ← back to feed
    </a>


    <article class="post comments-post">


        <div class="post-header">

            <div>

                <a
                    href="/u/<%= post.username %>"
                >
                    @<%= post.username %>
                </a>


                <% if (
                    post.display_name
                ) { %>

                    <span class="display-name">
                        <%= post.display_name %>
                    </span>

                <% } %>

            </div>


            <span class="post-date">

                <%= formatDate(
                    post.created_at
                ) %>

            </span>

        </div>


        <% if (
            post.community_name
        ) { %>

            <div class="post-community">

                <a
                    href="/c/<%= post.community_name %>"
                >
                    <%= post.community_name %>
                </a>

            </div>

        <% } %>


        <div class="post-content">

            <%= post.content %>

        </div>


    </article>


    <section class="comments-page">


        <div class="comments-title">

            <h1>
                comments
            </h1>

            <span>
                <%= comments.length %>
            </span>

        </div>


        <% if (
            !comments ||
            comments.length === 0
        ) { %>


            <div class="no-comments">

                no comments yet.

            </div>


        <% } else { %>


            <div class="comment-list">


                <% comments.forEach(comment => { %>


                    <article class="comment">


                        <div class="comment-header">


                            <a
                                href="/u/<%= comment.username %>"
                            >

                                @<%= comment.username %>

                            </a>


                            <% if (
                                comment.display_name
                            ) { %>

                                <span>
                                    <%= comment.display_name %>
                                </span>

                            <% } %>


                            <time>

                                <%= formatDate(
                                    comment.created_at
                                ) %>

                            </time>


                        </div>


                        <div class="comment-content">

                            <%= comment.content %>

                        </div>


                    </article>


                <% }) %>


            </div>


        <% } %>


    </section>


    <section class="comment-composer">


        <form
            class="comment-form"
            action="/posts/<%= post.id %>/comments"
            method="post"
        >


            <input
                type="text"
                name="content"
                maxlength="300"
                placeholder="write a comment..."
                autocomplete="off"
                required
            >


            <button
                type="submit"
            >
                comment
            </button>


        </form>


    </section>


</main>


</body>

</html>
