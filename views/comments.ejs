<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>comments - helloworld</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<nav>
    <a class="logo" href="/feed">helloworld</a>

    <div class="nav-right">
        <a href="/u/<%= user.username %>">
            @<%= user.username %>
        </a>

        <form action="/logout" method="post">
            <button class="logout" type="submit">
                logout
            </button>
        </form>
    </div>
</nav>

<main class="container">

    <div class="comments-page">

        <a class="back-link" href="/feed">
            ← back to feed
        </a>

        <article class="post">

            <div class="post-header">
                <a href="/u/<%= post.username %>">
                    @<%= post.username %>
                </a>

                <span>
                    <%= formatDate(post.created_at) %>
                </span>
            </div>

            <div class="post-content">
                <%= post.content %>
            </div>

        </article>

        <section class="comments-section">

            <h1>comments</h1>

            <% if (comments.length === 0) { %>

                <div class="no-comments">
                    no comments yet.
                </div>

            <% } else { %>

                <% comments.forEach(comment => { %>

                    <article class="comment">

                        <div class="comment-header">

                            <a href="/u/<%= comment.username %>">
                                @<%= comment.username %>
                            </a>

                            <span>
                                <%= formatDate(comment.created_at) %>
                            </span>

                        </div>

                        <div class="comment-content">
                            <%= comment.content %>
                        </div>

                    </article>

                <% }) %>

            <% } %>

        </section>

        <form
            class="comment-form"
            action="/posts/<%= post.id %>/comments"
            method="post"
        >

            <input
                type="text"
                name="content"
                maxlength="300"
                placeholder="write a comment..."
                autocomplete="off"
                required
            >

            <button type="submit">
                comment
            </button>

        </form>

    </div>

</main>

</body>
</html>
