<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>profile settings - helloworld</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

</head>

<body>

    <main class="site-main">

        <div class="page-container">

            <div class="page-header">

                <h1>profile settings</h1>

                <p>
                    change how your profile appears to other users.
                </p>

            </div>


            <% if (error) { %>

                <div class="error">
                    <%= error %>
                </div>

            <% } %>


            <% if (success) { %>

                <div class="success">
                    <%= success %>
                </div>

            <% } %>


            <form
                action="/settings/profile"
                method="post"
                enctype="multipart/form-data"
                class="settings-form"
            >

                <div class="settings-section">

                    <h2>profile picture</h2>

                    <div class="profile-picture-settings">

                        <div class="profile-picture-preview">

                            <% if (
                                user.profile_picture ||
                                user.profile_image_url
                            ) { %>

                                <img
                                    src="<%= user.profile_picture || user.profile_image_url %>"
                                    alt="your profile picture"
                                >

                            <% } else { %>

                                <div class="profile-picture-placeholder">
                                    <%= (
                                        user.display_name ||
                                        user.username ||
                                        "?"
                                    ).charAt(0).toUpperCase() %>
                                </div>

                            <% } %>

                        </div>


                        <div class="profile-picture-upload">

                            <label for="profile_picture">
                                upload a new picture
                            </label>

                            <input
                                id="profile_picture"
                                type="file"
                                name="profile_picture"
                                accept="image/jpeg,image/png,image/gif,image/webp"
                            >

                            <small>
                                png, jpg, gif, or webp. maximum 15mb.
                            </small>

                        </div>

                    </div>

                </div>


                <div class="settings-section">

                    <h2>profile information</h2>


                    <label for="display_name">
                        display name
                    </label>

                    <input
                        id="display_name"
                        type="text"
                        name="display_name"
                        value="<%= user.display_name || user.username %>"
                        maxlength="100"
                        autocomplete="nickname"
                    >


                    <label for="username">
                        username
                    </label>

                    <input
                        id="username"
                        type="text"
                        value="@<%= user.username %>"
                        disabled
                    >


                    <label for="bio">
                        bio
                    </label>

                    <textarea
                        id="bio"
                        name="bio"
                        maxlength="1000"
                        rows="7"
                        placeholder="tell people about yourself..."
                    ><%= user.bio || "" %></textarea>


                    <div class="character-count">
                        maximum 1000 characters
                    </div>

                </div>


                <div class="settings-actions">

                    <button
                        type="submit"
                        class="button primary"
                    >
                        save changes
                    </button>

                    <a
                        href="/u/<%= user.username %>"
                        class="button secondary"
                    >
                        cancel
                    </a>

                </div>

            </form>

        </div>

    </main>

</body>
</html>
