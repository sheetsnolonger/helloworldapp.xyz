<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>profile settings - helloworld</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<nav>
    <a class="logo" href="/feed">helloworld</a>

    <div class="nav-right">
        <a href="/feed">feed</a>
        <a href="/communities">communities</a>
        <a href="/search">search</a>

        <a href="/u/<%= user.username %>">
            @<%= user.username %>
        </a>

        <form action="/logout" method="post">
            <button
                class="logout"
                type="submit"
            >
                logout
            </button>
        </form>
    </div>
</nav>

<main class="container">

    <header class="feed-header">
        <div class="tiny">
            make your profile yours
        </div>

        <h1>profile settings</h1>

        <p>
            change how your profile appears to other people.
        </p>
    </header>

    <% if (error) { %>

        <div class="error">
            <%= error %>
        </div>

    <% } %>

    <section class="settings-card">

        <form
            action="/settings/profile"
            method="post"
        >

            <div class="form-group">

                <label for="display_name">
                    display name
                </label>

                <input
                    id="display_name"
                    type="text"
                    name="display_name"
                    value="<%= user.display_name || '' %>"
                    maxlength="40"
                    placeholder="your display name"
                    autocomplete="off"
                >

                <small>
                    up to 40 characters.
                </small>

            </div>

            <div class="form-group">

                <label for="bio">
                    bio
                </label>

                <textarea
                    id="bio"
                    name="bio"
                    maxlength="500"
                    placeholder="tell people a little about yourself..."
                ><%= user.bio || '' %></textarea>

                <small>
                    up to 500 characters.
                </small>

            </div>

            <div class="settings-actions">

                <button
                    type="submit"
                    class="primary-button"
                >
                    save changes
                </button>

                <a
                    class="button"
                    href="/u/<%= user.username %>"
                >
                    cancel
                </a>

            </div>

        </form>

    </section>

    <section class="settings-card account-info">

        <h2>account</h2>

        <div class="account-row">

            <span>username</span>

            <strong>
                @<%= user.username %>
            </strong>

        </div>

        <div class="account-row">

            <span>member since</span>

            <strong>
                <%= formatDate(user.created_at) %>
            </strong>

        </div>

    </section>

</main>

</body>
</html>
