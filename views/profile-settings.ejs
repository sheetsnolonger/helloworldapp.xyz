<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta
        name="viewport"
        content="width=device-width,initial-scale=1"
    >

    <title>edit profile — helloworld</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

<nav class="topbar">

    <a class="brand" href="/feed">
        helloworld
    </a>

    <div class="nav-links">
        <a href="/u/<%= user.username %>">
            profile
        </a>

        <a href="/feed">
            feed
        </a>
    </div>

</nav>

<main class="settings-page">

    <h1>edit profile</h1>

    <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
    <% } %>

    <form
        class="settings-form"
        action="/settings/profile"
        method="post"
        enctype="multipart/form-data"
    >

        <label>
            display name

            <input
                name="display_name"
                maxlength="40"
                value="<%= user.display_name || '' %>"
            >
        </label>

        <label>
            bio

            <textarea
                name="bio"
                maxlength="500"
            ><%= user.bio || '' %></textarea>
        </label>

        <label>
            profile picture

            <input
                type="file"
                name="profile_picture"
                accept="image/png,image/jpeg,image/webp,image/gif"
            >
        </label>

        <p class="muted">
            maximum image size: 5mb.
        </p>

        <button type="submit">
            save changes
        </button>

    </form>

</main>

</body>
</html>
