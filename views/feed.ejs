<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>helloworld</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >
</head>

<body>

<nav class="site-nav">

    <a
        class="logo"
        href="/feed"
    >
        helloworld
    </a>

    <div class="nav-right">

        <a href="/search">
            search
        </a>

        <a href="/communities">
            communities
        </a>

        <a href="/u/<%= user.username %>">
            @<%= user.username %>
        </a>

        <form
            action="/logout"
            method="post"
        >
            <button
                class="logout"
                type="submit"
            >
                logout
            </button>
        </form>

    </div>

</nav>


<main class="container">

    <header class="feed-header">

        <div class="tiny">
            your little corner of the internet
        </div>

        <h1>
            feed
        </h1>

        <p>
            see what people are saying.
        </p>

    </header>


    <section class="composer">

        <form
            action="/posts"
            method="post"
            enctype="multipart/form-data"
        >

            <textarea
                name="content"
                maxlength="500"
                placeholder="what's on your mind?"
                required
            ></textarea>


            <div class="composer-options">

                <label class="file-upload">

                    <span>
                        add image
                    </span>

                    <input
                        type="file"
                        name="attachment"
                        accept="image/png,image/jpeg,image/gif,image/webp"
                    >

                </label>


                <select
                    name="community_id"
                >

                    <option value="">
                        no community
                    </option>

                    <% if (communities && communities.length) { %>

                        <% communities.forEach(community => { %>

                            <option
                                value="<%= community.id %>"
                            >
                                c/<%= community.name %>
                            </option>

                        <% }) %>

                    <% } %>

                </select>


                <button
                    type="submit"
                >
                    post
                </button>

            </div>

        </form>

    </section>


    <% if (communities && communities.length) { %>

        <section class="community-list">

            <div class="section-heading">

                <h2>
                    communities
                </h2>

                <a href="/communities">
                    view all
                </a>

            </div>


            <div class="community-links">

                <% communities.slice(0, 8).forEach(community => { %>

                    <a
                        class="community-link"
                        href="/c/<%= encodeURIComponent(community.name) %>"
                    >

                        <strong>
                            c/<%= community.name %>
                        </strong>

                        <span>
                            <%= community.post_count || 0 %>
                            posts
                        </span>

                    </a>

                <% }) %>

            </div>

        </section>

    <% } %>


    <section class="posts">

        <% if (!posts || posts.length === 0) { %>

            <div class="empty">

                <p>
                    there aren't any posts yet.
                </p>

                <p>
                    make the first one.
                </p>

            </div>

        <% } %>


        <% if (posts && posts.length) { %>

            <% posts.forEach(post => { %>

                <article
                    class="post"
                    id="post-<%= post.id %>"
                >

                    <div class="post-header">

                        <div class="post-user">

                            <a
                                href="/u/<%= post.username %>"
                            >
                                @<%= post.username %>
                            </a>

                            <% if (post.display_name) { %>

                                <span class="display-name">
                                    <%= post.display_name %>
                                </span>

                            <% } %>

                        </div>


                        <span class="post-date">
                            <%= formatDate(post.created_at) %>
                        </span>

                    </div>


                    <% if (post.community_name) { %>

                        <div class="post-community">

                            <a
                                href="/c/<%= encodeURIComponent(post.community_name) %>"
                            >
                                c/<%= post.community_name %>
                            </a>

                        </div>

                    <% } %>


                    <a
                        class="post-main-link"
                        href="/posts/<%= post.id %>/comments"
                    >

                        <div class="post-content">
                            <%= post.content %>
                        </div>


                        <% if (post.attachment_url) { %>

                            <div class="post-attachment">

                                <img
                                    src="<%= post.attachment_url %>"
                                    alt="<%= post.attachment_name || 'post image' %>"
                                    loading="lazy"
                                >

                            </div>

                        <% } %>

                    </a>


                    <div class="post-actions">

                        <form
                            action="/posts/<%= post.id %>/like"
                            method="post"
                        >

                            <button
                                type="submit"
                                class="<%= post.liked ? 'liked' : '' %>"
                            >
                                <%= post.liked ? 'liked' : 'like' %>
                                <%= post.likes || 0 %>
                            </button>

                        </form>


                        <a
                            class="comments-link"
                            href="/posts/<%= post.id %>/comments"
                        >

                            <%= post.comments || 0 %>

                            <%= post.comments === 1
                                ? 'comment'
                                : 'comments'
                            %>

                        </a>


                        <% if (user && user.id === post.user_id) { %>

                            <form
                                action="/posts/<%= post.id %>/delete"
                                method="post"
                                onsubmit="return confirm('delete this post?');"
                            >

                                <button
                                    type="submit"
                                    class="delete-post"
                                >
                                    delete
                                </button>

                            </form>

                        <% } %>

                    </div>


                    <% if (
                        post.comment_list &&
                        post.comment_list.length
                    ) { %>

                        <div class="comment-preview">

                            <% post.comment_list.slice(0, 2).forEach(comment => { %>

                                <div class="comment-preview-item">

                                    <a
                                        href="/u/<%= comment.username %>"
                                    >
                                        @<%= comment.username %>
                                    </a>

                                    <span>
                                        <%= comment.content %>
                                    </span>

                                </div>

                            <% }) %>


                            <% if (post.comments > 2) { %>

                                <a
                                    class="view-comments"
                                    href="/posts/<%= post.id %>/comments"
                                >
                                    view all
                                    <%= post.comments %>
                                    comments
                                </a>

                            <% } %>

                        </div>

                    <% } %>


                    <form
                        class="comment-form"
                        action="/posts/<%= post.id %>/comments"
                        method="post"
                    >

                        <input
                            type="text"
                            name="content"
                            maxlength="300"
                            placeholder="write a comment..."
                            autocomplete="off"
                            required
                        >

                        <button
                            type="submit"
                        >
                            comment
                        </button>

                    </form>

                </article>

            <% }) %>

        <% } %>

    </section>

</main>

</body>
</html>
