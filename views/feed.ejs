<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>helloworld</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<nav>
    <a class="logo" href="/feed">helloworld</a>

    <div class="nav-right">
        <a href="/u/<%= user.username %>">
            @<%= user.username %>
        </a>

        <form action="/logout" method="post">
            <button class="logout" type="submit">
                logout
            </button>
        </form>
    </div>
</nav>

<main class="container">

    <header class="feed-header">
        <div class="tiny">your little corner of the internet</div>

        <h1>feed</h1>

        <p>
            see what people are saying.
        </p>
    </header>

    <section class="composer">

        <form action="/posts" method="post">

            <textarea
                name="content"
                maxlength="500"
                placeholder="what's on your mind?"
                required
            ></textarea>

            <button type="submit">
                post
            </button>

        </form>

    </section>

    <% if (!posts || posts.length === 0) { %>

        <div class="empty">
            <p>there aren't any posts yet.</p>
            <p>make the first one.</p>
        </div>

    <% } %>

    <% if (posts && posts.length > 0) { %>

        <% posts.forEach(post => { %>

            <article class="post">

                <div class="post-header">

                    <a href="/u/<%= post.username %>">
                        @<%= post.username %>
                    </a>

                    <div class="post-header-right">

                        <span>
                            <%= formatDate(post.created_at) %>
                        </span>

                        <% if (Number(post.user_id) === Number(user.id)) { %>

                            <form
                                class="delete-form"
                                action="/posts/<%= post.id %>/delete"
                                method="post"
                                onsubmit="return confirm('delete this post?');"
                            >
                                <button
                                    type="submit"
                                    class="delete-button"
                                >
                                    delete
                                </button>
                            </form>

                        <% } %>

                    </div>

                </div>

                <div class="post-content">
                    <%= post.content %>
                </div>

                <div class="post-actions">

                    <form
                        action="/posts/<%= post.id %>/like"
                        method="post"
                    >
                        <button
                            type="submit"
                            class="<%= post.liked ? 'liked' : '' %>"
                        >
                            <%= post.liked ? 'liked' : 'like' %>
                            <%= post.likes || 0 %>
                        </button>
                    </form>

                    <a
                        class="comments-link"
                        href="/posts/<%= post.id %>/comments"
                    >
                        comments
                        (<%= post.comments || 0 %>)
                    </a>

                </div>

            </article>

        <% }) %>

    <% } %>

</main>

</body>
</html>
