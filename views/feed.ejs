<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>helloworld</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >
</head>

<body>

    <!-- =====================================================
         navigation
         ===================================================== -->

<body>

<%- include("partials/sidebar") %>

<main class="container">


    <!-- =====================================================
         main feed
         ===================================================== -->

    <main class="container">


        <!-- header -->

        <header class="feed-header">

            <div class="tiny">
                your little corner of the internet
            </div>

            <h1>
                feed
            </h1>

            <p>
                see what people are saying.
            </p>

        </header>


        <!-- =================================================
             post composer
             ================================================= -->

        <section class="composer">

            <form
                action="/posts"
                method="post"
                enctype="multipart/form-data"
            >

                <textarea
                    name="content"
                    maxlength="500"
                    placeholder="what's on your mind?"
                    required
                ></textarea>


                <div class="composer-options">


                    <!-- image -->

                    <label class="file-upload">

                        <span class="composer-icon">

                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <rect
                                    x="3"
                                    y="4"
                                    width="18"
                                    height="16"
                                    rx="2"
                                />

                                <circle
                                    cx="8.5"
                                    cy="9"
                                    r="1.5"
                                />

                                <path
                                    d="m5 17 4.5-4.5 3 3 2-2 4.5 4.5"
                                />
                            </svg>

                        </span>

                        <span class="file-upload-text">
                            add image
                        </span>

                        <input
                            type="file"
                            name="attachment"
                            accept="image/png,image/jpeg,image/gif,image/webp"
                        >

                    </label>


                    <!-- community -->

                    <select
                        name="community_id"
                        aria-label="choose community"
                    >

                        <option value="">
                            no community
                        </option>

                        <% if (communities && communities.length) { %>

                            <% communities.forEach(community => { %>

                                <option
                                    value="<%= community.id %>"
                                >
                                    c/<%= community.name %>
                                </option>

                            <% }) %>

                        <% } %>

                    </select>


                    <!-- post -->

                    <button
                        type="submit"
                    >
                        post
                    </button>

                </div>

            </form>

        </section>


        <!-- =================================================
             communities
             ================================================= -->

        <% if (communities && communities.length) { %>

            <section class="community-list">

                <div class="section-heading">

                    <h2>
                        communities
                    </h2>

                    <a href="/communities">
                        view all
                    </a>

                </div>


                <div class="community-links">

                    <% communities.slice(0, 8).forEach(community => { %>

                        <a
                            class="community-link"
                            href="/c/<%= encodeURIComponent(community.name) %>"
                        >

                            <span class="community-icon">

                                <svg
                                    viewBox="0 0 24 24"
                                    aria-hidden="true"
                                >
                                    <circle
                                        cx="12"
                                        cy="12"
                                        r="8"
                                    />

                                    <path
                                        d="M12 8v8M8 12h8"
                                    />
                                </svg>

                            </span>

                            <strong>
                                c/<%= community.name %>
                            </strong>

                            <span>
                                <%= community.post_count || 0 %>
                            </span>

                        </a>

                    <% }) %>

                </div>

            </section>

        <% } %>


        <!-- =================================================
             posts
             ================================================= -->

        <section class="posts">

            <% if (!posts || posts.length === 0) { %>

                <div class="empty">

                    <strong>
                        there aren't any posts yet.
                    </strong>

                    <p>
                        make the first one.
                    </p>

                </div>

            <% } %>


            <% if (posts && posts.length) { %>

                <% posts.forEach(post => { %>

                    <article
                        class="post"
                        id="post-<%= post.id %>"
                    >


                        <!-- post header -->

                        <div class="post-header">

                            <div class="post-user">

                                <a
                                    href="/u/<%= post.username %>"
                                >
                                    @<%= post.username %>
                                </a>

                                <% if (post.display_name) { %>

                                    <span class="display-name">
                                        <%= post.display_name %>
                                    </span>

                                <% } %>

                            </div>


                            <span class="post-date">
                                <%= formatDate(post.created_at) %>
                            </span>

                        </div>


                        <!-- community -->

                        <% if (post.community_name) { %>

                            <div class="post-community">

                                <a
                                    href="/c/<%= encodeURIComponent(post.community_name) %>"
                                >
                                    c/<%= post.community_name %>
                                </a>

                            </div>

                        <% } %>


                        <!-- clickable post -->

                        <a
                            class="post-main-link"
                            href="/posts/<%= post.id %>/comments"
                        >

                            <div class="post-content">
                                <%= post.content %>
                            </div>


                            <% if (post.attachment_url) { %>

                                <div class="post-attachment">

                                    <img
                                        src="<%= post.attachment_url %>"
                                        alt="<%= post.attachment_name || 'post image' %>"
                                        loading="lazy"
                                    >

                                </div>

                            <% } %>

                        </a>


                        <!-- post actions -->

                        <div class="post-actions">


                            <!-- like -->

                            <form
                                action="/posts/<%= post.id %>/like"
                                method="post"
                            >

                                <button
                                    type="submit"
                                    class="<%= post.liked ? 'liked' : '' %>"
                                    aria-label="like post"
                                    title="like"
                                >

                                    <svg
                                        class="action-icon"
                                        viewBox="0 0 24 24"
                                        aria-hidden="true"
                                    >
                                        <path
                                            d="M20.8 8.7c0 5.5-8.8 10.2-8.8 10.2S3.2 14.2 3.2 8.7A4.7 4.7 0 0 1 12 6.2a4.7 4.7 0 0 1 8.8 2.5z"
                                        />
                                    </svg>

                                    <span>
                                        <%= post.likes || 0 %>
                                    </span>

                                </button>

                            </form>


                            <!-- comments -->

                            <a
                                class="comments-link"
                                href="/posts/<%= post.id %>/comments"
                                aria-label="comments"
                                title="comments"
                            >

                                <svg
                                    class="action-icon"
                                    viewBox="0 0 24 24"
                                    aria-hidden="true"
                                >
                                    <path
                                        d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 4v-4.2A2.5 2.5 0 0 1 4 13.5z"
                                    />
                                </svg>

                                <span>
                                    <%= post.comments || 0 %>
                                </span>

                            </a>


                            <!-- delete -->

                            <% if (user && user.id === post.user_id) { %>

                                <form
                                    action="/posts/<%= post.id %>/delete"
                                    method="post"
                                    onsubmit="return confirm('delete this post?');"
                                >

                                    <button
                                        type="submit"
                                        class="delete-post"
                                        aria-label="delete post"
                                        title="delete"
                                    >

                                        <svg
                                            class="action-icon"
                                            viewBox="0 0 24 24"
                                            aria-hidden="true"
                                        >
                                            <path
                                                d="M4 7h16"
                                            />

                                            <path
                                                d="M9 7V4h6v3"
                                            />

                                            <path
                                                d="m7 7 1 13h8l1-13"
                                            />

                                            <path
                                                d="M10 11v5M14 11v5"
                                            />
                                        </svg>

                                        <span>
                                            delete
                                        </span>

                                    </button>

                                </form>

                            <% } %>

                        </div>


                        <!-- comment preview -->

                        <% if (
                            post.comment_list &&
                            post.comment_list.length
                        ) { %>

                            <div class="comment-preview">

                                <% post.comment_list
                                    .slice(0, 2)
                                    .forEach(comment => { %>

                                    <div class="comment-preview-item">

                                        <a
                                            href="/u/<%= comment.username %>"
                                        >
                                            @<%= comment.username %>
                                        </a>

                                        <span>
                                            <%= comment.content %>
                                        </span>

                                    </div>

                                <% }) %>


                                <% if (post.comments > 2) { %>

                                    <a
                                        class="view-comments"
                                        href="/posts/<%= post.id %>/comments"
                                    >
                                        view all
                                        <%= post.comments %>
                                        comments
                                    </a>

                                <% } %>

                            </div>

                        <% } %>


                        <!-- comment form -->

                        <form
                            class="comment-form"
                            action="/posts/<%= post.id %>/comments"
                            method="post"
                        >

                            <input
                                type="text"
                                name="content"
                                maxlength="300"
                                placeholder="write a comment..."
                                autocomplete="off"
                                required
                            >

                            <button
                                type="submit"
                            >
                                comment
                            </button>

                        </form>


                    </article>

                <% }) %>

            <% } %>

        </section>

    </main>


    <!-- =====================================================
         icon styling
         ===================================================== -->

    <style>

        .nav-icon {
            display: inline-flex;

            align-items: center;
            justify-content: center;

            width: 22px;
            height: 22px;

            flex: 0 0 22px;
        }

        .nav-icon svg {
            width: 21px;
            height: 21px;

            fill: none;

            stroke: currentColor;

            stroke-width: 1.8;

            stroke-linecap: round;

            stroke-linejoin: round;
        }


        .nav-item {
            display: flex;

            align-items: center;

            gap: 12px;
        }


        .nav-label {
            white-space: nowrap;
        }


        .composer-icon,
        .community-icon {
            display: inline-flex;

            align-items: center;
            justify-content: center;
        }


        .composer-icon svg {
            width: 17px;
            height: 17px;

            fill: none;

            stroke: currentColor;

            stroke-width: 1.8;

            stroke-linecap: round;

            stroke-linejoin: round;
        }


        .community-icon svg {
            width: 15px;
            height: 15px;

            fill: none;

            stroke: currentColor;

            stroke-width: 1.7;

            stroke-linecap: round;

            stroke-linejoin: round;
        }


        .action-icon {
            width: 16px;
            height: 16px;

            flex: 0 0 16px;

            fill: none;

            stroke: currentColor;

            stroke-width: 1.8;

            stroke-linecap: round;

            stroke-linejoin: round;
        }


        .post-actions button,
        .comments-link,
        .delete-post {
            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 6px;
        }


        .post-main-link {
            display: block;

            color: inherit;

            text-decoration: none;
        }


        .post-main-link:hover {
            color: inherit;
        }


        .file-upload {
            display: inline-flex;

            align-items: center;

            gap: 7px;
        }


        @media (max-width: 800px) {

            .nav-right {
                width: 100%;
            }

            .nav-item {
                justify-content: center;

                gap: 0;
            }

            .nav-label {
                display: none;
            }

            .nav-icon {
                width: 23px;
                height: 23px;

                flex-basis: 23px;
            }

            .nav-icon svg {
                width: 22px;
                height: 22px;
            }

            .nav-settings {
                display: none;
            }

            .file-upload-text {
                display: none;
            }

            .composer-icon svg {
                width: 19px;
                height: 19px;
            }

        }

    </style>

</body>
</html>
