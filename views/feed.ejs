<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>feed - helloworld</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >
</head>

<body>

<nav>

    <a
        class="logo"
        href="/feed"
    >
        helloworld
    </a>

    <div class="nav-right">

        <a href="/search">
            search
        </a>

        <a href="/communities">
            communities
        </a>

        <a href="/u/<%= user.username %>">
            @<%= user.username %>
        </a>

        <form
            action="/logout"
            method="post"
        >
            <button
                class="logout"
                type="submit"
            >
                logout
            </button>
        </form>

    </div>

</nav>


<main class="container">


    <header class="feed-header">

        <div class="tiny">
            your little corner of the internet
        </div>

        <h1>
            feed
        </h1>

        <p>
            see what people are saying.
        </p>

    </header>


    <section class="composer">

        <form
            action="/posts"
            method="post"
        >

            <textarea
                name="content"
                maxlength="500"
                placeholder="what's on your mind?"
                required
            ></textarea>


            <% if (
                communities &&
                communities.length > 0
            ) { %>

                <select
                    name="community_id"
                >

                    <option value="">
                        no community
                    </option>

                    <% communities.forEach(community => { %>

                        <option
                            value="<%= community.id %>"
                        >
                            <%= community.name %>
                        </option>

                    <% }) %>

                </select>

            <% } %>


            <button type="submit">
                post
            </button>

        </form>

    </section>


    <% if (
        !posts ||
        posts.length === 0
    ) { %>

        <div class="empty">

            <p>
                there aren't any posts yet.
            </p>

            <p>
                make the first one.
            </p>

        </div>

    <% } %>


    <section class="posts">

        <% posts.forEach(post => { %>

            <article class="post">


                <div class="post-header">

                    <div>

                        <a
                            href="/u/<%= post.username %>"
                        >
                            @<%= post.username %>
                        </a>

                        <% if (
                            post.display_name
                        ) { %>

                            <span class="display-name">
                                <%= post.display_name %>
                            </span>

                        <% } %>

                    </div>


                    <span class="post-date">

                        <%= formatDate(
                            post.created_at
                        ) %>

                    </span>

                </div>


                <% if (
                    post.community_name
                ) { %>

                    <div class="post-community">

                        <a
                            href="/c/<%= post.community_name %>"
                        >
                            <%= post.community_name %>
                        </a>

                    </div>

                <% } %>


                <a
                    class="post-body-link"
                    href="/posts/<%= post.id %>/comments"
                >

                    <div class="post-content">

                        <%= post.content %>

                    </div>

                </a>


                <div class="post-actions">


                    <form
                        action="/posts/<%= post.id %>/like"
                        method="post"
                    >

                        <button
                            type="submit"
                            class="<%= post.liked ? 'liked' : '' %>"
                        >

                            <%= post.liked
                                ? "liked"
                                : "like" %>

                            <%= post.likes || 0 %>

                        </button>

                    </form>


                    <a
                        class="comments-link"
                        href="/posts/<%= post.id %>/comments"
                    >

                        <%= post.comments || 0 %>

                        <%= post.comments === 1
                            ? "comment"
                            : "comments" %>

                    </a>


                    <% if (
                        Number(post.user_id) ===
                        Number(user.id)
                    ) { %>

                        <form
                            action="/posts/<%= post.id %>/delete"
                            method="post"
                            onsubmit="return confirm('delete this post?');"
                        >

                            <button
                                class="delete-button"
                                type="submit"
                            >
                                delete
                            </button>

                        </form>

                    <% } %>


                </div>


            </article>

        <% }) %>

    </section>


</main>

</body>
</html>
