<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta
        name="viewport"
        content="width=device-width,initial-scale=1"
    >

    <title>feed — helloworld</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

<nav class="topbar">

    <a class="brand" href="/feed">
        helloworld
    </a>

    <form
        class="search"
        action="/search"
        method="get"
    >
        <input
            name="q"
            placeholder="search"
        >
    </form>

    <div class="nav-links">
        <a href="/communities">communities</a>
        <a href="/u/<%= user.username %>">
            @<%= user.username %>
        </a>

        <form action="/logout" method="post">
            <button class="text-button">
                logout
            </button>
        </form>
    </div>

</nav>

<main class="layout">

    <section class="feed">

        <div class="page-title">
            <h1>feed</h1>
            <p>what's happening?</p>
        </div>

        <section class="composer">

            <form action="/posts" method="post">

                <textarea
                    name="content"
                    maxlength="500"
                    placeholder="what's on your mind?"
                    required
                ></textarea>

                <div class="composer-bottom">

                    <select name="community_id">
                        <option value="">
                            no community
                        </option>

                        <% communities.forEach(community => { %>

                            <option
                                value="<%= community.id %>"
                            >
                                <%= community.name %>
                            </option>

                        <% }) %>
                    </select>

                    <button type="submit">
                        post
                    </button>

                </div>

            </form>

        </section>

        <% if (!posts.length) { %>

            <div class="empty">
                no posts yet.
            </div>

        <% } %>

        <% posts.forEach(post => { %>

            <article class="post">

                <div class="post-head">

                    <% if (post.profile_picture) { %>

                        <img
                            class="avatar"
                            src="<%= post.profile_picture %>"
                            alt=""
                        >

                    <% } else { %>

                        <div class="avatar placeholder">
                            <%= post.username[0].toUpperCase() %>
                        </div>

                    <% } %>

                    <div>
                        <a
                            class="username"
                            href="/u/<%= post.username %>"
                        >
                            <%= post.display_name || post.username %>
                        </a>

                        <div class="post-meta">
                            @<%= post.username %>
                            ·
                            <%= formatDate(post.created_at) %>
                        </div>
                    </div>

                </div>

                <% if (post.community_name) { %>

                    <a
                        class="community-tag"
                        href="/c/<%= post.community_name %>"
                    >
                        #<%= post.community_name %>
                    </a>

                <% } %>

                <a
                    class="post-body"
                    href="/posts/<%= post.id %>/comments"
                >
                    <%= post.content %>
                </a>

                <div class="post-actions">

                    <form
                        action="/posts/<%= post.id %>/like"
                        method="post"
                    >
                        <button class="<%= post.liked ? 'liked' : '' %>">
                            like <%= post.likes || 0 %>
                        </button>
                    </form>

                    <a
                        href="/posts/<%= post.id %>/comments"
                    >
                        comments <%= post.comments || 0 %>
                    </a>

                    <% if (post.username === user.username) { %>

                        <form
                            action="/posts/<%= post.id %>/delete"
                            method="post"
                            onsubmit="return confirm('delete this post?')"
                        >
                            <button class="danger-button">
                                delete
                            </button>
                        </form>

                    <% } %>

                </div>

            </article>

        <% }) %>

    </section>

    <aside class="sidebar">

        <div class="sidebar-box">
            <h3>communities</h3>

            <a
                class="sidebar-link"
                href="/communities"
            >
                view all
            </a>

            <% communities.slice(0, 10).forEach(community => { %>

                <a
                    class="community-item"
                    href="/c/<%= community.name %>"
                >
                    <strong>
                        #<%= community.name %>
                    </strong>

                    <span>
                        <%= community.post_count %> posts
                    </span>
                </a>

            <% }) %>
        </div>

    </aside>

</main>

</body>
</html>
