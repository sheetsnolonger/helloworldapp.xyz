<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta
        name="viewport"
        content="width=device-width,initial-scale=1"
    >

    <title>communities — helloworld</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

<nav class="topbar">

    <a class="brand" href="/feed">
        helloworld
    </a>

    <div class="nav-links">
        <a href="/feed">feed</a>
        <a href="/communities">communities</a>
    </div>

</nav>

<main class="page">

    <div class="page-title">
        <h1>communities</h1>
        <p>places to find people with similar interests.</p>
    </div>

    <section class="community-grid">

        <% if (!communities.length) { %>

            <div class="empty">
                no communities yet.
            </div>

        <% } %>

        <% communities.forEach(community => { %>

            <a
                class="community-card"
                href="/c/<%= community.name %>"
            >

                <h2>
                    #<%= community.name %>
                </h2>

                <p>
                    <%= community.description || "no description." %>
                </p>

                <small>
                    <%= community.post_count %> posts
                </small>

            </a>

        <% }) %>

    </section>

</main>

</body>
</html>
