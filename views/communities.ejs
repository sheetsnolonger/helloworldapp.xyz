<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>communities - helloworld</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<nav>
    <a class="logo" href="/feed">helloworld</a>

    <div class="nav-right">
        <a href="/feed">feed</a>

        <a href="/communities">
            communities
        </a>

        <a href="/search">
            search
        </a>

        <a href="/u/<%= user.username %>">
            @<%= user.username %>
        </a>

        <form action="/logout" method="post">
            <button
                class="logout"
                type="submit"
            >
                logout
            </button>
        </form>
    </div>
</nav>

<main class="container">

    <header class="feed-header">
        <div class="tiny">
            find your little corner of the internet
        </div>

        <h1>communities</h1>

        <p>
            explore the communities people have created.
        </p>
    </header>

    <% if (!communities || communities.length === 0) { %>

        <section class="empty">
            <p>
                there aren't any communities yet.
            </p>

            <p>
                check back later.
            </p>
        </section>

    <% } else { %>

        <section class="communities-grid">

            <% communities.forEach(community => { %>

                <a
                    class="community-card"
                    href="/c/<%= encodeURIComponent(community.name) %>"
                >

                    <div class="community-card-header">

                        <h2>
                            /<%= community.name %>
                        </h2>

                        <span>
                            <%= community.post_count || 0 %>
                            <%= Number(community.post_count) === 1 ? "post" : "posts" %>
                        </span>

                    </div>

                    <% if (community.description) { %>

                        <p class="community-description">
                            <%= community.description %>
                        </p>

                    <% } else { %>

                        <p class="community-description muted">
                            no description yet.
                        </p>

                    <% } %>

                    <div class="community-card-footer">
                        view community →
                    </div>

                </a>

            <% }) %>

        </section>

    <% } %>

</main>

</body>
</html>
