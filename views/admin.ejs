<!doctype html>
<html>
<head>
    <meta charset="utf-8">

    <meta
        name="viewport"
        content="width=device-width,initial-scale=1"
    >

    <title>admin — helloworld</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

<nav class="topbar">

    <a class="brand" href="/feed">
        helloworld
    </a>

    <strong>
        admin panel
    </strong>

    <form
        action="<%= adminPath %>/logout"
        method="post"
    >
        <button class="text-button">
            logout
        </button>
    </form>

</nav>

<main class="admin-page">

    <header class="page-title">

        <h1>admin panel</h1>

        <p>
            manage users, posts, and communities.
        </p>

    </header>

    <section class="admin-section">

        <h2>create community</h2>

        <form
            class="admin-form"
            action="<%= adminPath %>/communities/create"
            method="post"
        >

            <input
                name="name"
                maxlength="50"
                placeholder="community name"
                required
            >

            <input
                name="description"
                maxlength="300"
                placeholder="description"
            >

            <button type="submit">
                create
            </button>

        </form>

    </section>

    <section class="admin-section">

        <h2>communities</h2>

        <% communities.forEach(community => { %>

            <div class="admin-row">

                <div>
                    <strong>
                        #<%= community.name %>
                    </strong>

                    <span>
                        <%= community.post_count %> posts
                    </span>
                </div>

                <div class="admin-actions">

                    <a
                        href="/c/<%= community.name %>"
                        target="_blank"
                    >
                        view
                    </a>

                    <form
                        action="<%= adminPath %>/communities/<%= community.id %>/delete"
                        method="post"
                        onsubmit="return confirm('delete this community?')"
                    >
                        <button class="danger-button">
                            delete
                        </button>
                    </form>

                </div>

            </div>

        <% }) %>

    </section>

    <section class="admin-section">

        <h2>posts</h2>

        <% posts.forEach(post => { %>

            <div class="admin-row">

                <div>

                    <strong>
                        @<%= post.username %>
                    </strong>

                    <% if (post.community_name) { %>

                        <span>
                            #<%= post.community_name %>
                        </span>

                    <% } %>

                    <p>
                        <%= post.content %>
                    </p>

                </div>

                <form
                    action="<%= adminPath %>/posts/<%= post.id %>/delete"
                    method="post"
                    onsubmit="return confirm('delete this post?')"
                >

                    <button class="danger-button">
                        delete
                    </button>

                </form>

            </div>

        <% }) %>

    </section>

    <section class="admin-section">

        <h2>users</h2>

        <% users.forEach(account => { %>

            <div class="admin-row">

                <div>

                    <strong>
                        @<%= account.username %>
                    </strong>

                    <span>
                        <%= account.display_name %>
                    </span>

                </div>

                <div class="admin-actions">

                    <a
                        href="/u/<%= account.username %>"
                        target="_blank"
                    >
                        view
                    </a>

                    <form
                        action="<%= adminPath %>/users/<%= account.id %>/delete"
                        method="post"
                        onsubmit="return confirm('delete this account and all of its content?')"
                    >

                        <button class="danger-button">
                            delete
                        </button>

                    </form>

                </div>

            </div>

        <% }) %>

    </section>

</main>

</body>
</html>
