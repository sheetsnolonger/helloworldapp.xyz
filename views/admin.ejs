<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>helloworld admin</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .admin-section {
            margin: 30px 0;
        }

        .admin-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;

            margin-bottom: 10px;
            padding: 15px;

            border: 1px solid white;
            border-radius: 14px;

            background: rgba(255,255,255,.85);
        }

        .admin-item-content {
            min-width: 0;
            flex: 1;
        }

        .admin-item-content strong {
            color: #075d87;
        }

        .admin-item-content p {
            margin: 5px 0 0;
            word-break: break-word;
        }

        .admin-delete {
            flex-shrink: 0;

            border: 1px solid white;

            background:
                linear-gradient(
                    to bottom,
                    #ef8585,
                    #b63838
                );
        }

        .admin-create {
            padding: 20px;

            border: 1px solid white;
            border-radius: 18px;

            background: rgba(255,255,255,.8);
        }

        .admin-create form {
            gap: 10px;
        }

        .admin-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;

            margin-top: 40px;
        }

        @media (max-width: 600px) {
            .admin-item {
                align-items: flex-start;
                flex-direction: column;
            }

            .admin-delete {
                width: 100%;
            }
        }
    </style>
</head>

<body>

<nav>
    <a class="logo" href="/feed">
        helloworld
    </a>

    <form
        action="/mavellorinthal/logout"
        method="post"
    >
        <button class="logout" type="submit">
            logout
        </button>
    </form>
</nav>

<main class="container">

    <div class="admin-top">
        <div>
            <div class="tiny">
                restricted administration
            </div>

            <h1>
                admin panel
            </h1>
        </div>
    </div>

    <section class="admin-section">

        <h2>
            create community
        </h2>

        <div class="admin-create">

            <form
                action="/mavellorinthal/communities"
                method="post"
            >

                <label for="name">
                    community name
                </label>

                <input
                    id="name"
                    name="name"
                    maxlength="50"
                    placeholder="music"
                    pattern="[a-z0-9_-]{2,50}"
                    required
                >

                <label for="description">
                    description
                </label>

                <textarea
                    id="description"
                    name="description"
                    maxlength="300"
                    placeholder="talk about music."
                ></textarea>

                <button type="submit">
                    create community
                </button>

            </form>

        </div>

    </section>

    <section class="admin-section">

        <h2>
            communities
        </h2>

        <% if (communities.length === 0) { %>

            <p class="muted">
                no communities yet.
            </p>

        <% } %>

        <% communities.forEach(community => { %>

            <div class="admin-item">

                <div class="admin-item-content">

                    <strong>
                        /<%= community.name %>
                    </strong>

                    <p>
                        <%= community.description || "no description." %>
                    </p>

                </div>

                <form
                    action="/mavellorinthal/communities/<%= community.id %>/delete"
                    method="post"
                >
                    <button
                        class="admin-delete"
                        type="submit"
                    >
                        delete
                    </button>
                </form>

            </div>

        <% }) %>

    </section>

    <section class="admin-section">

        <h2>
            posts
        </h2>

        <% if (posts.length === 0) { %>

            <p class="muted">
                no posts.
            </p>

        <% } %>

        <% posts.forEach(post => { %>

            <div class="admin-item">

                <div class="admin-item-content">

                    <strong>
                        @<%= post.username %>
                    </strong>

                    <p>
                        <%= post.content %>
                    </p>

                </div>

                <form
                    action="/mavellorinthal/posts/<%= post.id %>/delete"
                    method="post"
                >
                    <button
                        class="admin-delete"
                        type="submit"
                    >
                        delete
                    </button>
                </form>

            </div>

        <% }) %>

    </section>

    <section class="admin-section">

        <h2>
            accounts
        </h2>

        <% if (users.length === 0) { %>

            <p class="muted">
                no accounts.
            </p>

        <% } %>

        <% users.forEach(account => { %>

            <div class="admin-item">

                <div class="admin-item-content">

                    <strong>
                        @<%= account.username %>
                    </strong>

                    <p>
                        <%= account.post_count %>
                        posts
                    </p>

                </div>

                <form
                    action="/mavellorinthal/users/<%= account.id %>/delete"
                    method="post"
                    onsubmit="return confirm('delete this account permanently?')"
                >
                    <button
                        class="admin-delete"
                        type="submit"
                    >
                        delete account
                    </button>
                </form>

            </div>

        <% }) %>

    </section>

</main>

</body>
</html>
