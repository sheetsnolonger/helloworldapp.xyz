<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>helloworld admin</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >
</head>

<body>

<main class="container admin-page">

    <header class="feed-header">

        <div class="tiny">
            private administration
        </div>

        <h1>admin panel</h1>

        <p>
            manage helloworld.
        </p>

    </header>

    <div class="admin-actions">

        <a href="/feed">
            back to feed
        </a>

        <form
            action="<%= adminPath %>/logout"
            method="post"
        >
            <button type="submit">
                logout
            </button>
        </form>

    </div>

    <section class="admin-section">

        <h2>create community</h2>

        <form
            action="<%= adminPath %>/communities/create"
            method="post"
            class="admin-form"
        >

            <input
                type="text"
                name="name"
                maxlength="50"
                placeholder="community name"
                required
            >

            <textarea
                name="description"
                maxlength="300"
                placeholder="community description"
            ></textarea>

            <button type="submit">
                create community
            </button>

        </form>

    </section>

    <section class="admin-section">

        <h2>communities</h2>

        <% if (!communities || communities.length === 0) { %>

            <p>
                no communities yet.
            </p>

        <% } else { %>

            <div class="admin-list">

                <% communities.forEach(community => { %>

                    <article class="admin-item">

                        <div>
                            <strong>
                                <a
                                    href="/c/<%= community.name %>"
                                >
                                    /c/<%= community.name %>
                                </a>
                            </strong>

                            <p>
                                <%= community.description || "no description." %>
                            </p>

                            <small>
                                <%= community.post_count || 0 %>
                                posts
                            </small>
                        </div>

                        <form
                            action="<%= adminPath %>/communities/<%= community.id %>/delete"
                            method="post"
                            onsubmit="return confirm('delete this community?');"
                        >
                            <button
                                type="submit"
                                class="danger"
                            >
                                delete
                            </button>
                        </form>

                    </article>

                <% }) %>

            </div>

        <% } %>

    </section>

    <section class="admin-section">

        <h2>posts</h2>

        <% if (!posts || posts.length === 0) { %>

            <p>
                no posts yet.
            </p>

        <% } else { %>

            <div class="admin-list">

                <% posts.forEach(post => { %>

                    <article class="admin-item">

                        <div>

                            <strong>
                                @<%= post.username %>
                            </strong>

                            <% if (post.community_name) { %>

                                <a
                                    href="/c/<%= post.community_name %>"
                                >
                                    /c/<%= post.community_name %>
                                </a>

                            <% } %>

                            <p>
                                <%= post.content %>
                            </p>

                            <small>
                                <%= formatDate(post.created_at) %>
                            </small>

                        </div>

                        <div class="admin-item-actions">

                            <a
                                href="/posts/<%= post.id %>/comments"
                            >
                                comments
                            </a>

                            <form
                                action="<%= adminPath %>/posts/<%= post.id %>/delete"
                                method="post"
                                onsubmit="return confirm('delete this post?');"
                            >
                                <button
                                    type="submit"
                                    class="danger"
                                >
                                    delete
                                </button>
                            </form>

                        </div>

                    </article>

                <% }) %>

            </div>

        <% } %>

    </section>

    <section class="admin-section">

        <h2>accounts</h2>

        <% if (!users || users.length === 0) { %>

            <p>
                no accounts yet.
            </p>

        <% } else { %>

            <div class="admin-list">

                <% users.forEach(account => { %>

                    <article class="admin-item">

                        <div>

                            <strong>
                                <a
                                    href="/u/<%= account.username %>"
                                >
                                    @<%= account.username %>
                                </a>
                            </strong>

                            <% if (account.display_name) { %>

                                <p>
                                    <%= account.display_name %>
                                </p>

                            <% } %>

                            <small>
                                joined
                                <%= formatDate(account.created_at) %>
                            </small>

                        </div>

                        <form
                            action="<%= adminPath %>/users/<%= account.id %>/delete"
                            method="post"
                            onsubmit="return confirm('delete this account and all of its posts?');"
                        >
                            <button
                                type="submit"
                                class="danger"
                            >
                                delete account
                            </button>
                        </form>

                    </article>

                <% }) %>

            </div>

        <% } %>

    </section>

</main>

</body>
</html>
