<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>settings - helloworld</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <nav class="site-nav">

        <a class="logo" href="/feed">
            helloworld
        </a>

        <div class="nav-right">

            <a href="/feed" class="nav-item">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>
                    </svg>
                </span>

                <span class="nav-label">home</span>
            </a>


            <a href="/search" class="nav-item">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="6.5"/>
                        <path d="m16 16 5 5"/>
                    </svg>
                </span>

                <span class="nav-label">search</span>
            </a>


            <a href="/communities" class="nav-item">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 4v-4.2A2.5 2.5 0 0 1 4 13.5z"/>
                        <path d="M8 8h8M8 11h5"/>
                    </svg>
                </span>

                <span class="nav-label">communities</span>
            </a>


            <a href="/u/<%= user.username %>" class="nav-item">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="8" r="3.5"/>
                        <path d="M5 21c.8-4 3.2-6 7-6s6.2 2 7 6"/>
                    </svg>
                </span>

                <span class="nav-label">
                    @<%= user.username %>
                </span>
            </a>


            <a href="/settings/profile" class="nav-item active">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="3"/>
                        <path d="M19 12a7 7 0 0 0-.1-1.2l2-1.5-2-3.4-2.3.9a7 7 0 0 0-2-1.2L14.3 3h-4.6l-.3 2.6a7 7 0 0 0-2 1.2l-2.3-.9-2 3.4 2 1.5A7 7 0 0 0 5 12c0 .4 0 .8.1 1.2l-2 1.5 2 3.4 2.3-.9a7 7 0 0 0 2 1.2l.3 2.6h4.6l.3-2.6a7 7 0 0 0 2-1.2l2.3.9 2-3.4-2-1.5c.1-.4.1-.8.1-1.2z"/>
                    </svg>
                </span>

                <span class="nav-label">settings</span>
            </a>


            <form action="/logout" method="post">

                <button
                    type="submit"
                    class="logout nav-item"
                >
                    <span class="nav-icon">
                        <svg viewBox="0 0 24 24">
                            <path d="M10 5H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4"/>
                            <path d="M14 8l4 4-4 4"/>
                            <path d="M9 12h9"/>
                        </svg>
                    </span>

                    <span class="nav-label">logout</span>
                </button>

            </form>

        </div>

    </nav>


    <main class="main-content">

        <div class="settings-page">

            <div class="page-header">

                <div class="tiny">
                    account
                </div>

                <h1>
                    settings
                </h1>

                <p>
                    manage your account and profile.
                </p>

            </div>


            <section class="settings-section">

                <h2>
                    profile
                </h2>

                <p class="settings-description">
                    update the information shown on your profile.
                </p>


                <form
                    action="/settings/profile"
                    method="post"
                    enctype="multipart/form-data"
                >

                    <div class="form-group">

                        <label for="display_name">
                            display name
                        </label>

                        <input
                            id="display_name"
                            type="text"
                            name="display_name"
                            maxlength="50"
                            value="<%= user.display_name || '' %>"
                            placeholder="display name"
                        >

                    </div>


                    <div class="form-group">

                        <label for="bio">
                            bio
                        </label>

                        <textarea
                            id="bio"
                            name="bio"
                            maxlength="300"
                            placeholder="tell people about yourself..."
                        ><%= user.bio || '' %></textarea>

                    </div>


                    <div class="form-group">

                        <label for="profile_picture">
                            profile picture
                        </label>

                        <input
                            id="profile_picture"
                            type="file"
                            name="profile_picture"
                            accept="image/png,image/jpeg,image/gif,image/webp"
                        >

                    </div>


                    <div class="form-actions">

                        <button type="submit">
                            save changes
                        </button>

                    </div>

                </form>

            </section>


            <section class="settings-section">

                <h2>
                    account
                </h2>

                <div class="settings-row">

                    <span>
                        username
                    </span>

                    <strong>
                        @<%= user.username %>
                    </strong>

                </div>


                <% if (user.email) { %>

                    <div class="settings-row">

                        <span>
                            email
                        </span>

                        <strong>
                            <%= user.email %>
                        </strong>

                    </div>

                <% } %>

            </section>


            <section class="settings-section danger-section">

                <h2>
                    logout
                </h2>

                <p class="settings-description">
                    sign out of your account.
                </p>

                <form action="/logout" method="post">

                    <button
                        type="submit"
                        class="button-danger"
                    >
                        log out
                    </button>

                </form>

            </section>

        </div>

    </main>

</body>
</html>
