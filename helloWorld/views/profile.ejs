<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@<%= user.username %> · helloWorld</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav>
        <a href="/feed" class="logo">helloWorld</a>
        <div class="nav-right"><a href="/feed">home</a></div>
    </nav>
    <main class="container">
        <section class="profile">
            <div class="avatar"><%= user.username.charAt(0) %></div>
            <div>
                <p class="tiny">profile</p>
                <h1>@<%= user.username %></h1>
                <p class="muted"><%= user.bio || "still figuring out what to put here." %></p>
                <div class="stats">
                    <span><strong><%= followers %></strong> followers</span>
                    <span><strong><%= following %></strong> following</span>
                </div>
                <% if (currentUser.id !== user.id) { %>
                    <form method="post" action="/u/<%= user.username %>/follow">
                        <button><%= isFollowing ? "unfollow" : "follow" %></button>
                    </form>
                <% } %>
            </div>
        </section>
        <section class="feed">
            <% posts.forEach(post => { %>
                <article class="post">
                    <div class="post-header">
                        <span>@<%= user.username %></span>
                        <span><%= formatDate(post.created_at) %></span>
                    </div>
                    <p class="post-content"><%= post.content %></p>
                    <div class="post-actions"><span>likes · <%= post.likes %></span></div>
                </article>
            <% }) %>
        </section>
    </main>
</body>
</html>